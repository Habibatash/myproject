# Copy this file to .env and change every secret before production.
SECRET_KEY=replace-this-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=
DATABASE_URL=
TIME_ZONE=Asia/Kabul

# Email verification is ON by default. For REAL emails configure SMTP and use the smtp backend:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend  (Gmail: smtp.gmail.com + App Password)
EMAIL_VERIFICATION_REQUIRED=True
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@example.com

# Server-side Anthropic AI. Keep the API key out of GitHub and browsers.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# JSON list of secure HTTPS RSS feeds. Example:
# NEWS_FEEDS_JSON=[{"name":"Example feed","url":"https://example.com/rss.xml"}]
# Built-in feeds (Afghanistan, Pakistan, Iran, USA) are used automatically; NEWS_FEEDS_JSON only ADDS more feeds.
# Optional region per feed: afghanistan | pakistan | iran | usa
NEWS_FEEDS_JSON=[]
NEWS_USE_DEFAULT_FEEDS=True
NEWS_AUTOFETCH=True
NEWS_FETCH_INTERVAL_MIN=10
NEWS_KEEP_DAYS=14
