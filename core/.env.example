# Copy this file to .env and change every secret before production.
SECRET_KEY=replace-this-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=
DATABASE_URL=
TIME_ZONE=Asia/Kabul

# Email verification is optional. To enable, configure real SMTP first.
EMAIL_VERIFICATION_REQUIRED=False
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@example.com

# Server-side Anthropic AI. Keep the API key out of GitHub and browsers.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# JSON list of secure HTTPS RSS feeds. Example:
# NEWS_FEEDS_JSON=[{"name":"Example feed","url":"https://example.com/rss.xml"}]
NEWS_FEEDS_JSON=[]
NEWS_AUTOFETCH=True
NEWS_FETCH_INTERVAL_MIN=15
NEWS_KEEP_DAYS=14
